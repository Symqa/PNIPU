@page
@model IndexModel
@{
    ViewData["Title"] = "Выполнение SQL";
}

<!-- Генерируем скрытый токен безопасности (обязательно для ASP.NET!) -->
@Html.AntiForgeryToken()

<div class="container mt-4 text-center">
    <h3>Выполнение запросов</h3>

    <textarea id="sql-input" class="form-control w-50 mx-auto mb-3" rows="4" placeholder="Введите SQL..."></textarea>

    <button class="btn btn-primary" onclick="sendQueryToServer()">Выполнить на сервере</button>

    <!-- Блок для вывода ответа от сервера -->
    <div id="server-response" class="alert mt-3 w-50 mx-auto" style="display: none;"></div>
</div>

<script>
       async function sendQueryToServer() {
        const sqlText = document.getElementById('sql-input').value;
        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

        try {
            const response = await fetch('?handler=ExecuteSql', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': csrfToken
                },
                body: JSON.stringify({ Query: sqlText })
            });

            const data = await response.json();
            const responseBox = document.getElementById('server-response');
            responseBox.style.display = 'block';

            if (data.success) {
                responseBox.className = 'alert alert-success mt-3 w-75 mx-auto text-start';

                // Если сервер вернул флаг isData = true (то есть прислал таблицу)
                if (data.isData) {
                    // Строим HTML таблицу
                    let tableHtml = `<div class="mb-2"><strong>${data.message}</strong></div>`;
                    tableHtml += `<table class="table table-bordered table-sm table-hover mt-2 bg-white">`;

                    // Шапка таблицы
                    tableHtml += `<thead class="table-dark"><tr>`;
                    data.columns.forEach(col => {
                        tableHtml += `<th>${col}</th>`;
                    });
                    tableHtml += `</tr></thead>`;

                    // Тело таблицы
                    tableHtml += `<tbody>`;
                    data.rows.forEach(row => {
                        tableHtml += `<tr>`;
                        row.forEach(cell => {
                            tableHtml += `<td>${cell}</td>`;
                        });
                        tableHtml += `</tr>`;
                    });
                    tableHtml += `</tbody></table>`;

                    // Вставляем сгенерированную таблицу в наш блок
                    responseBox.innerHTML = tableHtml;
                } else {
                    // Если это был обычный запрос без таблицы (например, CREATE)
                    responseBox.innerHTML = `<strong>${data.message}</strong>`;
                }
            } else {
                // Ошибка SQL
                responseBox.className = 'alert alert-danger mt-3 w-75 mx-auto text-start';
                responseBox.innerHTML = `<strong>${data.message}</strong>`;
            }
        }
        catch (error) {
            console.error("Ошибка сети:", error);
        }
    }

</script>